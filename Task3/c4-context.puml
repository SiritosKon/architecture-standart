@startuml c4-context
!include <C4/C4_Context>

title Схема контекста (первый уровень) — Открытие депозитов онлайн (MVP)

Person(new_client, "Новый клиент", "Потенциальный клиент, ещё не идентифицирован банком")
Person(client, "Клиент банка", "Авторизованный пользователь интернет-банка")
Person(cc_manager, "Менеджер кол-центра", "Обрабатывает заявки, консультирует по ставкам")
Person(bo_deposit, "Менеджер бэк-офиса (депозиты)", "Обрабатывает заявку, подтверждает условия депозита")
Person(bo_credit, "Сотрудник бэк-офиса (кредиты)", "Ведёт справочник ставок в части кред. риска")

System(site, "Сайт банка", "Витрина продуктов + форма заявки на депозит (PHP, React)")
System(ib, "Интернет-банк", "Веб-приложение, монолит (ASP.NET MVC 4.5, MS SQL)")
System(deposit_svc, "Депозитный сервис (новый)", "Заявки на депозит + витрина ставок. Java Spring Boot, PostgreSQL, Kafka")
System(abs, "АБС", "Учёт операций, открытие депозитов, справочник ставок (Delphi, Oracle, PL/SQL)")
System(cc, "Система кол-центра", "Обработка обращений (React, Java Spring Boot, PostgreSQL)")
System(notif, "Сервис нотификаций (новый)", "Отправка уведомлений; не знает про депозиты. Java Spring Boot")
System(sms, "СМС-шлюз", "Отправка СМС, поддержка IT-отдела банка")
System_Ext(telecom, "Телеком-оператор", "Внешняя отправка СМС")

Rel(new_client, site, "Смотрит депозиты и ставки, подаёт заявку (телефон, ФИО)", "HTTPS")
Rel(site, deposit_svc, "Получает актуальные ставки для витрины", "HTTPS")
Rel(site, cc, "Создаёт заявку-лид", "HTTPS")
Rel(cc_manager, cc, "Видит заявку, перезванивает, заносит обращение")
Rel(cc, deposit_svc, "Передаёт обращение/заявку клиента на обработку", "REST/HTTPS")

Rel(client, ib, "Смотрит каталог и ставки, подаёт заявку, смотрит свои депозиты", "HTTPS")
Rel(ib, deposit_svc, "Витрина ставок, подача заявки", "REST/HTTPS")

Rel(deposit_svc, abs, "Заявки на обработку; получает ставки и статусы", "Kafka, async")
Rel(deposit_svc, notif, "Запрос на отправку СМС (коды, уведомления)", "REST/HTTPS")
Rel(notif, sms, "Отправка СМС", "HTTPS")
Rel(sms, telecom, "Отправка СМС")
Rel(telecom, new_client, "Доставляет СМС")
Rel(telecom, client, "Доставляет СМС")

Rel(bo_deposit, abs, "Обрабатывает заявку, подтверждает условия и открывает депозит")
Rel(bo_deposit, abs, "Ведёт справочник ставок (депозиты)")
Rel(bo_credit, abs, "Ведёт справочник ставок (кред. риск)")

' --- layout: два параллельных входных потока (новый клиент → Сайт, клиент банка → ИБ) ---
Lay_R(new_client, client)
Lay_D(new_client, site)
Lay_D(client, ib)

SHOW_LEGEND()
@enduml
